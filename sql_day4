cursor.execute(""" with season_count as (
                SELECT  manager, COUNT(*) as total_seasons
                FROM seasons
                GROUP BY manager
                )
                SELECT * FROM season_count WHERE total_seasons >= 2
            """)

for season_cnt in cursor.fetchall():
