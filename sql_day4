cursor.execute("""SELECT manager, pos
FROM (
    SELECT manager, AVG(position) as pos
    FROM seasons
    GROUP BY manager
) AS manager_stats
WHERE pos < (SELECT AVG(position) FROM seasons);""")
for manager_avg_cnt in cursor.fetchall():
    print(manager_avg_cnt)

cursor.execute(""" WITH manager_avg as (
                SELECT manager, AVG(position) as pos
                FROM seasons
                GROUP BY manager
                ),
                position_avg as (
                SELECT AVG(position) as avg_pos FROM seasons
                )
                SELECT manager, pos from manager_avg
                CROSS JOIN position_avg
                WHERE pos < avg_pos

""")
for manager_avg_cnt in cursor.fetchall():
    print(manager_avg_cnt)


cursor.execute(""" WITH high_goal_scorers as (
                SELECT s.season, s.position, ts.player, ts.goals
                FROM seasons s
                INNER JOIN
                top_scorers ts
                ON s.season = ts.season
                WHERE ts.goals >= 15 
                )
                SELECT  *
                FROM high_goal_scorers
                where position <= 4

""")
for higher_goal_row in cursor.fetchall():
    print(higher_goal_row)